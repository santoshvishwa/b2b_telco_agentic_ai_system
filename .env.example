# Copy to .env (never commit .env). Everything here is optional; defaults are shown.

# --- Provider routing -------------------------------------------------------
# Default provider for every agent: "ollama" (local, free) or "anthropic" (API, token-capped)
FIBERPULSE_PROVIDER=ollama

# Per-agent override, e.g. send only Agent 4 to the API once you reach the benchmark:
# FIBERPULSE_PROVIDER_PARADOX_TRIAGE=anthropic

# --- Ollama (local) ---------------------------------------------------------
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Qwen3 "thinking" mode. Keep false: it cut a test prompt from 76s to 15s on your laptop.
OLLAMA_THINK=false
# Context window. 8192 keeps RAM use predictable on a 32 GB machine.
OLLAMA_NUM_CTX=8192

# --- Anthropic API (budget-capped) ------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Your key's total allowance, and the point at which the token meter refuses calls.
# The hard limit sits below the cap on purpose, so estimates can never push you over.
API_TOKEN_CAP=100000
API_TOKEN_HARD_LIMIT=90000

# --- Misc ---------------------------------------------------------------------
FIBERPULSE_DATA_DIR=data
FIBERPULSE_MAX_PARSE_RETRIES=2
